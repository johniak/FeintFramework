// Migration: {{ migration.MigrationName }}
using FeintFramework.Db.Migrator;
using FeintFramework.Db.Migrator.Fields;
using FeintFramework.Db.Migrator.Operations;

namespace {{ migration.Namespace }}
{
    class {{ migration.ClassName }} : BaseMigration
    {
        public override (string ApplicationName, string MigrationName)[] Dependencies => [
            {{ for dep in migration.Dependencies }}
                ( "{{ dep.ApplicationName }}", "{{ dep.MigrationName }}" ){{ if !for.last }},{{ end }}
            {{ end }}
        ];

        public override bool Initial => {{ migration.Initial }};
        public override MigrationOperation[] Operations => [
            {{ for op in migration.Operations }}
                {{ op }}{{ if !for.last }},{{ end }}
            {{ end }}
        ];
    }
}
